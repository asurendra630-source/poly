# PRODUCTION .env — STRICT DEPLOYMENT CONFIGURATION
# Generated 2026-08-07 after performance audit
# DO NOT COPY-PASTE TO LIVE WITHOUT READING THE CHECKLIST BELOW

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT STATUS: DRY-RUN ONLY — NO MEASURED EDGE. DO NOT GO LIVE.
# ═══════════════════════════════════════════════════════════════════════════════
#
# Reported dry-run result (99 settles, 82.4h, claude.log): PnL +$57.66,
# mean +$0.5824, t +2.178, win rate 57/99. This is NOT independent evidence.
# Dry-run settlement at up_kimi.py:5847 decides the winner with
#     up_won = final_spot > open_spot
# which is the SAME spot-vs-open reference --latarb-analyze grades with. The
# PnL and its grader share an input, so the number cannot disconfirm anything.
#
# Scored instead against each market's own terminal book verdict (a resolved
# binary quotes one side only: 0.99/0.01), the same 50 gated first-signals give
#
#     scope     reference        n   win rate   EV/share      t
#     full      spot-vs-open    50     78.0%     +0.3371   +5.59
#     full      book verdict    50     44.0%     -0.0029   -0.05
#     holdout   spot-vs-open    28     71.4%     +0.2738   +3.15
#     holdout   book verdict    28     28.6%     -0.1548   -1.98
#
# Cost settles which reference is honest: mean entry 0.4268 vs book win rate
# 44.0% = the market priced it fair. The spot reference instead implies a
# 35-point mispricing left standing on a liquid book.
#
# The two references agree on 94.0% of all 3,245 scorable markets but on only
# 66% of the 50 the gates SELECT, and the disagreement is directional. The
# gates concentrate on exactly the markets where the grader is unreliable.
#
# CONFIG SWEEP: 5,250 combinations of LATENCY_ARB_EDGE / LATARB_ASK_CAP /
# LATENCY_ARB_MIN_PROB / LATARB_SHADOW_MAX_AGE_MS / MIN_TOP_BOOK_USDC, selected
# on the earlier 60% of markets by time and re-scored on the untouched later
# 40%. 416 reached n>=15. ZERO had positive book EV both in and out of sample;
# the best in-sample (+0.2369) fell to -0.0393 out of sample.
#
# => No value in this file makes the strategy profitable. The previous header
#    ("continue dry-run to ~164 settles") treated sample size as the only
#    defect; more settles cannot fix a reference problem, they only produce a
#    more confident wrong number. Settings below are therefore left at their
#    audited values: nothing here is tuned toward a live launch.
#
# Reproduce:  python _agent_scratch/tune_latarb.py
#             python _agent_scratch/grade_reference.py
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Execution mode (THE ONLY LIVE LOCK THAT MATTERS) ────────────────────────
DRY_RUN=true
# When true: all other proof/bootstrap gates are structurally inert.
# When false: REQUIRE_LATARB_LIVE_PROOF + LATARB_BOOTSTRAP_LIVE gates activate.

#MEASURE_ONLY=

# ─── Credentials ─────────────────────────────────────────────────────────────
POLYMARKET_PRIVATE_KEY=<REDACTED-64-HEX-PRIVATE-KEY>
POLYMARKET_PROXY_ADDRESS=<REDACTED-WALLET-ADDRESS>
POLYMARKET_SIGNATURE_TYPE=2

# ─── Market scope ────────────────────────────────────────────────────────────
COINS=BTC,ETH,SOL
CYCLE_S=300

# ─── Risk caps (account reality: $3.39 USDC wallet) ─────────────────────────
MIN_ORDER_USDC=2.0
MAX_ORDER_USDC=4.0
# KNOWN CEILING: the shock detector (up_kimi.py:4475) compares old-vs-new balance
# with no accounting for our OWN fills, so >= $6 of fills inside one
# BALANCE_REFRESH_S=15 window still reads as an external withdrawal. Post-R36
# that cancels resting BUYs + cooldown (:9921) instead of halting. Sizing this
# above the worst-case same-window self-debit would need $32 (8 x $4), which
# makes shock detection useless on a wallet this size. Left at 6.0 deliberately.
CAPITAL_SHOCK_FLOOR_USDC=6.0
MAX_POSITION_USDC=6.0
MAX_BANKROLL_FRACTION=0.90
MAX_DAILY_LOSS=5.0
MAX_DAILY_LOSS_PCT=0.0
MAX_MONTHLY_LOSS=8.0
# R36: was 10.0, which halted a PROFITABLE session on 2026-08-07 (day was
# +$16.59 net, peak +$28.16, give-back $11.57 > $10 cap). Must clear
# MAX_CONSECUTIVE_LOSSES x MAX_ORDER_USDC = 4 x $4 = $16, otherwise the
# drawdown halt pre-empts the consec-loss halt and the latter never binds.
# $16 also clears the worst per-day give-back observed over the run ($11.57).
MAX_DRAWDOWN_FROM_PEAK=12.0
MAX_NET_EXPOSURE_USDC=20.0
MAX_GROSS_EXPOSURE_USDC=40.0
MAX_OPEN_ORDERS=8
MAX_CONSECUTIVE_LOSSES=3

# ─── Strategy gates (Directional HARD DISABLED) ──────────────────────────────
MIN_EDGE=0.95
MIN_EDGE_MARGIN=0.005
SPREAD_EDGE_MULT=0.20
SIGMA_EDGE_MULT=0.10
MARKET_ANCHOR_WEIGHT=0.5
MAX_MODEL_DISAGREEMENT=0.06
ANCHOR_EDGE_PATH=true
MOMENTUM_WEIGHT=0.0
PROB_SHRINK=1.0
PROB_MODEL=gbm_v183
SALVAGE_FLOOR=0.05
KELLY_FRACTION=0.18
STOP_LOSS_PROB=0.43
SUSTAIN_TICKS=1
ENTRY_MODE=taker
MAKER_JOIN_TICKS=0

# ─── Entry / exit timing ─────────────────────────────────────────────────────
ENTRY_START_S=15
ENTRY_END_S=260
STRATEGY_INTERVAL_S=1.5
FORCED_EXIT_TTC_S=25
TIME_DECAY_EXIT_TTC_S=90
FAST_EXIT_DROP_PCT=0.06
FAST_EXIT_SUSTAIN=2
EV_EXIT_BUFFER=0.0
TRAIL_STOP_PCT=0.12
TRAIL_SUSTAIN=2
TRAIL_ARM_LEVEL=0.65
PARTIAL_TP_ENABLED=true
TP_MODE=confidence
TP1_PCT=0.35
TP1_CLIP_PCT=0.40
TP1_BREAKEVEN_STOP=true
CONF_SCALE=1.0
CONF_MIN_CLIP=0.30
CONF_MAX_CLIP=0.95

# ─── Fees ────────────────────────────────────────────────────────────────────
TAKER_FEE_BPS=20.0
CATEGORY_FEE_RATE=0.07
BALANCE_REFRESH_S=15.0
PER_COIN_CROSSOVER=true
AUTO_FLATTEN_ON_HALT=false
FORCED_EXIT_HOLD_IF_WINNING=true
FORCED_EXIT_HOLD_PROB=0.60
KELLY_HOLD_TO_EXPIRY_RATE=0.0

# ─── Toxic-flow avoidance ────────────────────────────────────────────────────
WHALE_TRADE_USDC=5000.0
WHALE_COOLDOWN_S=3.0
SHADOW_PROBE_ENABLED=true
ADVERSE_SELECT_GATE=true
ADVERSE_EWMA_ALPHA=0.10
MAX_ADVERSE_BPS=25.0

# ─── Liquidity gates ─────────────────────────────────────────────────────────
MIN_TOP_BOOK_USDC=6.0
MAX_SPREAD_PCT=0.10

# ─── Go/no-go gate (Directional only) ────────────────────────────────────────
REQUIRE_PROVEN_EDGE=false

# ─── Latency-arb SHADOW measurement ──────────────────────────────────────────
LATARB_SHADOW=true
LATARB_SHADOW_PATH=~/latarb_shadow_v20_strict.csv
LATARB_SHADOW_MIN_AGE_MS=0.0
LATARB_SHADOW_THROTTLE_MS=3000.0
LATARB_SHADOW_MAX_AGE_MS=250.0

# ─── Latency-arb Strategy (PROOF-GATED) ──────────────────────────────────────
LATENCY_ARB_ENABLED=true
LATENCY_ARB_EDGE=0.020
LATENCY_ARB_COOLDOWN_S=2.0
LATENCY_ARB_MIN_PROB=0.50

# Ask cap. The old note here ("current median for tradeable = 0.56") is wrong
# under both readings of "tradeable", measured 2026-08-11 from
# latarb_shadow_v20_strict.csv (_agent_scratch/env_claims.py):
#   median chosen ask over rows with entry_fillable=1 (n=3122): 0.0200
#   median entry cost over fully gated first-signals (n=50)   : 0.4650
# entry_fillable is a LIQUIDITY flag, not a signal (rows carry it with
# edge=-0.41), which is why its median sits far out of the money. The gated
# median 0.4650 is the number an ask-cap decision turns on, and it is well
# under 0.65 — so this cap is not currently the binding gate. Do NOT raise it:
# the sweep found no cap value with out-of-sample edge (see header).
LATARB_ASK_CAP=0.85

# Live authorization — READ CAREFULLY:
#
# The gate at up_kimi.py:9127 only runs when DRY_RUN=false, so while DRY_RUN=true
# both settings below are structurally inert (DRY_RUN is the only live lock).
#
# REQUIRE_LATARB_LIVE_PROOF=true enforces fill+settle evidence before live trading.
# LATARB_BOOTSTRAP_LIVE=true allows min-size trading when evidence insufficient.
#
# WHY BOOTSTRAP MUST STAY TRUE:
# - live_n counts only rows with dry_run=false (up_kimi.py:6089-6090)
# - Those can only be produced BY trading live
# - bootstrap=false + 0 live rows = FatalBotError at every live boot, forever
# - Bootstrap IS the min-size canary that breaks chicken-and-egg
# - In bootstrap mode, _live_proof_ok stays False → size clipped to MIN_ORDER_USDC
#
# Current status: 99 dry settles (live-proof ignores all 99), 0 live rows
#
# DO NOT set REQUIRE_LATARB_LIVE_PROOF=false (removes safety gate)
# DO NOT set LATARB_BOOTSTRAP_LIVE=false (creates permanent deadlock)
REQUIRE_LATARB_LIVE_PROOF=true
LATARB_BOOTSTRAP_LIVE=true

# Live-proof thresholds. NOTE these are two DIFFERENT gates, not one:
#   LATARB_MIN_PROVEN_SIGNALS=200 is checked OFFLINE by --latarb-analyze
#     (up_kimi.py:10496 global, :10515 PER-COIN) and counts distinct markets,
#     not settles. The boot-time 200-signal gate was removed (:9122-9126).
#   LATARB_MIN_SETTLE_SAMPLES=20 etc. are the live fill/settle proof at :9127.
# Measured 2026-08-11 from latarb_shadow_v20_strict.csv (env_claims.py). The
# previous note here claimed "405 with entry_fillable=1 -> global 200 PASSES,
# per-coin FAILS on all three (BTC 141, ETH 132, SOL 132)". Both halves are
# wrong:
#   * :10496 counts n = winners + losers, "first-signal-per-market" — i.e.
#     markets that clear the FULL gate chain, not markets holding a fillable
#     row. That is 50, not 405, so the global 200 gate FAILS.
#   * per-coin is BTC 9 / ETH 18 / SOL 23 (the 141/132/132 figures were
#     fillable-row counts). All three are < 200, so :10515-10516 hits
#     `continue` and skips them — per-coin CANNOT fail while undersampled.
# --latarb-analyze = NO-GO, on the global signal count alone.
#
# LATARB_MIN_WIN_RATE below is a FALLBACK only: :10499 replaces it with a
# dynamic breakeven of mean_cost + 0.01 whenever breakeven_n > 0, which on this
# log is 0.4268 + 0.01 = 0.4368. Editing 0.52 changes nothing in practice.
LATARB_MIN_PROVEN_SIGNALS=200
LATARB_MIN_WIN_RATE=0.52
LATARB_MIN_TOTAL_PNL=0.0
LATARB_MIN_LIVE_ATTEMPTS=50
LATARB_MIN_LIVE_FILL_RATE=0.4
LATARB_MIN_SETTLE_SAMPLES=20
LATARB_MIN_SETTLE_WIN_RATE=0.52
LATARB_MIN_SETTLE_PNL=0.0

# ─── On-chain redemption ─────────────────────────────────────────────────────
REDEEM_ENABLED=true
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
REDEEM_MAX_GAS_GWEI=300.0

# ─── Disabled strategies ─────────────────────────────────────────────────────
COMPLEMENT_ARB_ENABLED=false

# ─── Endpoints ───────────────────────────────────────────────────────────────
CLOB_URL=https://clob.polymarket.com
GAMMA_URL=https://gamma-api.polymarket.com
CHAIN_ID=137

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CALIBRATION_LOG_PATH=~/calibration_v20_strict.csv
CALIBRATION_LOG_ENABLED=true
METRICS_ENABLED=true

# ─── Dry-run simulation ──────────────────────────────────────────────────────
DRY_RUN_FILL_PROB=0.7
DRY_RUN_LATENCY_MS=50.0

# ─── Performance / internals ─────────────────────────────────────────────────
WS_SHARD_COUNT=2
EVENT_DRIVEN=true
ORDER_RATE_LIMIT_PER_SEC=12
MAX_BOOK_AGE_MS=500
EVAL_DEBOUNCE_MS=400
MAX_CONCURRENT_EVALS=5
DISCOVERY_INTERVAL_S=10.0
ADAPTIVE_KELLY=true
RECONCILE_FILLS_INTERVAL_S=30.0
DRIFT_HALT_THRESHOLD_SHARES=0.01
DRIFT_CHECK_CONCURRENCY=4

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT CHECKLIST — READ BEFORE SETTING DRY_RUN=false
# ═══════════════════════════════════════════════════════════════════════════════
#
# [x] 20+ settled outcomes — MET: 99 dry settles (claude.log 2026-08-07..08-11).
#     The local ~/latarb_settle.jsonl holds only 12 rows from an EARLIER run
#     (2026-08-06T13:40..08-07T01:45, sum +$7.63 — the old header quoted THIS
#     file, and its ts are ISO strings while :5474 now writes float epoch, so
#     those rows predate this build). All 99 settles did pass the :5473 ledger
#     guard — verified: correction==realized in 99/99 SETTLED lines, which
#     :5882 produces only when strategy=='latarb' — with 0 write failures
#     logged, so the run's ledger exists on the box it ran on and was never
#     copied here alongside claude.log and the two CSVs.
# [ ] Edge ≥2% via: python up_kimi.py --latarb-analyze <shadow_csv>
#     NO-GO on the GLOBAL gate (:10496), which counts winners+losers =
#     first-signal-per-market = 50, not the 405 markets holding a fillable row.
#     50 < LATARB_MIN_PROVEN_SIGNALS=200. The per-coin gate (:10515) is BTC 9 /
#     ETH 18 / SOL 23 and cannot fail while every coin is under 200 — :10516
#     `continue`s on undersampled coins. (The old 141/132/132 figures counted
#     fillable rows, not signals.)
# [ ] Win rate ≥52% with statistical significance (binomial p<0.05)
#     NOT MET: 57.6% (57W/42L), 95% CI [47.8%, 67.3%] — includes 50%. And this
#     rate is graded by the circular spot-vs-open reference (see header); under
#     each market's own terminal book verdict the gated fires are 44.0%.
# [?] Settle ledger ≥20 entries — CANNOT EVALUATE from the files present here.
# [?] Fill ledger ≥40% fill rate — ~/latarb_fills.jsonl is ABSENT here. Only
#     meaningful once live attempts exist; dry rows are ignored (:10551).
# [x] Capital shock floor (6.0) > max order size (4.0) — true, but this only
#     covers the :4475 drop detector. The :9918 free-cash halt was a SEPARATE
#     path this item never checked; removed in R36 (see note above).
# [ ] Wallet ≥ $7.34, NOT $6 (current: $3.39). Derivation: :6976 skips every
#     entry unless free * MAX_BANKROLL_FRACTION >= MIN_ORDER_USDC, i.e. free
#     >= $3.34 at ALL times, and one max clip ties up $4.00 -> $7.34.
#     Below that the bot still trades, just one position at a time:
#       $3.39 -> sizing clips to $2.03 (bankroll cap), one min clip, then idle
#                until it settles
#       $6.00 -> one $4 clip, then free $2.00 -> $1.20 < $2.00 -> idle
#       $6.67 -> first bankroll level where MAX_ORDER_USDC=$4 is reachable
#       $7.34 -> a second concurrent position becomes possible
#
# [ ] BLOCKING, and not satisfiable by more dry-run settles: positive EV under
#     each market's own terminal book verdict, out of sample. Currently
#     -0.1548 EV/share on the held-out 40% (t=-1.98), and 0 of 416 sampled
#     configs clear it both in and out of sample. Every item above can pass
#     while this fails, because they are all graded by the same reference the
#     dry-run PnL is produced with. Re-check with
#     `python _agent_scratch/tune_latarb.py` before trusting the list.
#
# If all above pass:
#   1. Set DRY_RUN=false in THIS file
#      (verified 2026-08-11: find_dotenv resolves to this file, no home .env)
#   2. Verify bootstrap mode activates (logs: "LATARB LIVE-PROOF: BOOTSTRAP")
#   3. Monitor first 10 trades at MIN_ORDER_USDC=$2.00
#   4. Check adverse selection in logs (target: <25bps against us)
#   5. After 20 live settles pass, sizing scales to MAX_ORDER_USDC=$4.00
#
# ═══════════════════════════════════════════════════════════════════════════════

# ==== R39 / 2026-08-18: keys added after the venue-reconciled review ====
# explicitly so the band is visible in one place.
#
# Why a floor exists at all: sigma is pegged to GBM_SIGMA_FLOOR_PER_SEC in
# 10,569/10,569 shadow rows, so every z shrinks toward zero and model_prob
# lands in 0.5593-0.6238 for ALL 20 ttc>=30 candidates. That makes
#     edge = model_prob - ask - costs
# almost purely `0.56 - ask`. The "edge" gate is therefore an ASK gate: a big
# edge means a cheap book, not a mispricing. Measured:
#     edge >  0.15 : n=9   mean ask 0.2411
#     edge <= 0.15 : n=11  mean ask 0.4682
# The four largest "edges" (0.5408 / 0.4958 / 0.4691 / 0.3969) sit at asks of
# 0.01 / 0.08 / 0.08 / 0.16 — a 40+ point disagreement with a liquid book
# seconds from expiry, i.e. degenerate one-sided books. The 0.16 one is fill #25
# (market 3652966): it booked the ledger's largest apparent win and LOST
# on-chain.
#
# 0.20 drops exactly those 4 candidates and 1 of 29 fills, leaving the band that
# actually traded (0.33-0.53) intact. An edge CAP is the wrong tool for this —
# 0.15 would drop 9/20 candidates and 6/29 fills to catch the same 4.
# Applied in the live gate AND both --latarb-analyze replay gates, or backtests
# silently diverge from live. Checked by test_r38_fee_units_and_ask_floor.py.
LATARB_MIN_ASK=0.20

# estimate (source=dry-oracle-close) and ZERO from an authoritative winner —
# there were no market_resolved pushes at all, so the on-chain grader was never
# given an input. Reconciled against the venue, 8 of those 25 named the WRONG
# winner (32%), which is how the ledger showed 88% wr / +$58.68 where the truth
# was 56% / +$10.68. The estimate graded itself.
#
# R38 added a poll of CLOB /markets/{conditionId} -> tokens[].winner and holds
# the estimate back until this window expires. 480s is bounded on both sides by
# measurement, not preference:
#   > 429s  the measured lag from true interval end to the winner appearing
#           on chain (NOTE: the slug epoch in btc-updown-5m-<epoch> is the
#           interval START, so a raw +729s reading is 729-300=429s)
#   < 600s  DRY_STALE_SETTLE_S, the flat-close backstop — above it, a market
#           that never resolves on chain would be retained forever.
# Settles that fall back are now labelled dry-spot-ESTIMATE (never
# dry-oracle-close) and every SETTLED line reports the estimated fraction.
DRY_ONCHAIN_WAIT_S=570
DRY_RUN_BANKROLL_USDC=0.0
