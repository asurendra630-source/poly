# =============================================================================
# DRYRUN_ONLY.env - R49 loosened measurement run.  rev7 2026-08-28 (6 coins)
#
# PURPOSE: produce a model_prob -> realised-outcome calibration curve.
# It is a CALIBRATION EXPERIMENT, not a profit attempt. Expect NEGATIVE dry PnL.
# nc.py:9967 records the bot's own measurement of the live signal:
#   "18.8% win rate at avg entry 0.503, EV -0.63/$, reproducing the realised
#    -$22.62 over 25 trades"
# Every value below is either (a) copied from a verified nc.py line, or (b) a
# loosening tied to a counted skip. Comments corrected in rev2 where rev1 was
# wrong; each correction names the nc.py line that disproved it.
#
# NEVER SOURCE THIS FOR A LIVE RUN. Filename ends in .env so it survives the
# maxdepth-1 find that removed .env.soak. supervise_dry.sh refuses to launch
# unless DRY_RUN=true.
# =============================================================================

# --- HARD LOCK -----------------------------------------------------------
DRY_RUN=true
REDEEM_ENABLED=false

# --- CAPITAL: $1000 simulated (operator instruction 2026-08-30) ----------
# opus.py:9618  _env_float('DRY_RUN_BANKROLL_USDC', 0.0) or <computed floor>
# Set EXPLICITLY to 1000 by operator instruction so the paper run reads as a
# $1000 book. This SUPERSEDES rev7's "no phantom $1000" line, which was a
# measurement choice. 0 would mean AUTO = 5/0.6 + 150 = 158.33.
#
# VERIFIED LIMIT - do not misread this number. It does NOT change clip size:
#   opus.py:8036  sizes up only inside `if self._live_proof_ok:`
#   opus.py:10950 hard-sets `_live_proof_ok = False` whenever cfg.dry_run,
#                 unconditionally, every 60s status cycle
#   MAX_ORDER_USDC=5.0 pins it a SECOND time, independently
# So every LatArb clip is exactly $5 no matter what bankroll says. $1000 moves
# only the equity base and halt headroom. Exposure is unchanged too:
# opus.py:5025 net_cap = min(MAX_NET_EXPOSURE_USDC=100, bankroll*1.0) = 100.
#
# Raising the clip is NOT advised on evidence: measured top-of-book depth p05
# is $11.63, so a $100 clip walks the ladder and the simulated fill price would
# be dominated by book-walk slippage instead of by the signal.
# Real wallet is $6.48 with $0.00 MATIC, so nothing can execute for real.
DRY_RUN_BANKROLL_USDC=1000

# --- CONSTANT STAKE ------------------------------------------------------
# rev2 CORRECTION. rev1 said MIN==MAX was needed to fix B3 (Kelly disabled by
# max < 2*min). Verified at nc.py:8005-8016: sz = min_order_size, and the depth-
# limited Kelly branch runs ONLY under `if self._live_proof_ok:`. nc.py:10917
# forces `_live_proof_ok = False` whenever cfg.dry_run. So in ANY dry run every
# LatArb clip is exactly MIN_ORDER_USDC and Kelly is unreachable by construction.
# MIN==MAX is therefore not a fix, it is documentation: it makes the env state
# what the code already guarantees, so the constant $5 stake is explicit.
MIN_ORDER_USDC=5.0
MAX_ORDER_USDC=5.0
MAX_POSITION_USDC=10.0
MAX_BANKROLL_FRACTION=0.60

# --- RISK HALTS: real, calibrated to fire on PATHOLOGY not variance ------
# Fixes B2 by construction rather than by disabling it: B2 was
# MAX_DRAWDOWN_FROM_PEAK < MAX_CONSECUTIVE_LOSSES x MAX_ORDER_USDC, which let a
# net-profitable session halt on give-back. Here 15 x $5 = $75 < $150.
# 15 consecutive losses at p_loss~0.5 over 200 trades: 200/2^15 = 0.006 expected
# occurrences, ~0.6% false-halt risk. A genuine circuit breaker.
# .env values (4 / $16 / $10) would halt inside the first hour and kill the run.
MAX_CONSECUTIVE_LOSSES=15
MAX_DRAWDOWN_FROM_PEAK=150.0
MAX_DAILY_LOSS=150.0
MAX_MONTHLY_LOSS=600.0
MAX_NET_EXPOSURE_USDC=100.0
MAX_GROSS_EXPOSURE_USDC=200.0

# The only SILENT stop left in the risk chain. nc.py:9115 does
# `if self.om.count >= max_open_orders: return False` with no _halt() and no skip
# counter, so hitting it stops trading with nothing in the log to say why.
# `.env` sets 8; 15 is nc.py:527's own default. FAK orders resolve immediately so
# count (nc.py:3117 counts only PENDING/OPEN) should never approach either, but a
# stuck order must not be able to end the run invisibly.
MAX_OPEN_ORDERS=15

# nc.py:9062: when MAX_DAILY_LOSS_PCT > 0 it takes precedence and MAX_DAILY_LOSS
# is NEVER consulted. 0.0 forces the hard-dollar path so the $150 above is the
# cap actually in force. Latent trap, not an active one - `.env` also has 0.0 -
# but a nonzero pct on a $158 paper bankroll would cap the day at a few dollars.
MAX_DAILY_LOSS_PCT=0.0

# --- R47 MEASUREMENT FIX: KEEP. Local .env still holds the stale 480. ----
# 480 sits below the measured CLOB winner-publication boundary (0% readable
# below 570s, 100% at/above it), which routed 41-57% of settles to the CIRCULAR
# spot estimator. 900/960 gave 21/21 agreement with Gamma ground truth.
# DRY_STALE_SETTLE_S must stay ABOVE DRY_ONCHAIN_WAIT_S or the flat-close
# backstop books $0 PnL before the on-chain winner arrives.
DRY_ONCHAIN_WAIT_S=900
DRY_STALE_SETTLE_S=960

# --- DATA LAYER: two defects. One is DETECTED in code; both stay unfixed ---
# --- upstream, because both root-cause to off-box behaviour we cannot reach. ---
# rev6. rev4 set WS_MAX_QUEUE=256 and defended it on three grounds. Measurement
# has since killed all three, so it goes back to 4096. 7668 WSDUTY samples in
# _audit_20260827/opus.log (66.43h, PID 189175, which ran at 4096) say:
#   paused_obs=0 in 7668/7668  -> our reader NEVER paused, not once, in 66h
#   qhigh=4096  in 7668/7668  -> the env DID reach the library
#   qmax        p50=92  p90=257  p99=643  max=2488  (61% of the 4096 bound)
#   duty        p50=0.032 max=0.105       mean_handle_ms ~0.05
# So 256 was WRONG, not merely unhelpful: qmax p90 is 257, i.e. a 256 bound would
# have paused the reader in 10.00% of all 60s windows (767/7668), introducing the
# very Assembler pause that rev2 called the disease. The memory ground is void too
# - the bound only caps a TRANSIENT, and the 2488-frame peak it would clip already
# happened under 4096; lowering it is an untested memory remedy with a measured
# downside. The diagnostic ground is spent: paused_obs=0 across 7668 samples has
# already answered the question qmax was meant to probe.
# 4096 is therefore not a guess - it is the one configuration with 66h of measured,
# never-paused operation. Full derivation: sol_ver.md R50.15.
#
# DEFECT 1 - `1013 slow consumer` closes, ~7.8/h. STILL OPEN, no env fix.
#   The backpressure hypothesis is REFUTED three ways: 16 vs 4096 moved the rate
#   8.54 -> 7.84/h (ratio 0.919, exact conditional-binomial p=0.3837); per-shard
#   token counts peak at 24/26 and are flat; subscribe bursts show no association.
#   paused_obs=0 x 7668 closes it off mechanically - we never stopped reading, so
#   the cause is off-box (network path or venue-side). Do NOT score this run on the
#   close rate: ~7-8.7/h is the expected BASELINE, not a regression.
#
# DEFECT 2 - throughput stall. DETECTED in code (nc.py), NOT auto-recovered.
#   Day 2 of that log, 04:03:31-07:56:37: BOTH shards ran at 0.1-23.9 msg/s for
#   3.9h against a 542.8/s clean median - peak 4.4% of normal. 423 windows had
#   msgs<1000 (15.4% of that day; days 0/1/3 = 6/4/0). Both shards degraded within
#   50s of each other and recovered in the same window, which is why this is read
#   as off-box, not a per-socket bug.
#   Root cause, verified: _health_loop restarts a shard on `age > 90` where age =
#   now - _last_msgs[sid], and _last_msgs is refreshed by ANY message; the ALL-stale
#   path needs max(ages) > 120. worst_gap peaked at 71.1s (p90 55.0s), always under
#   90s, so NEITHER could fire. Confirmed by absence: `Shard N stale` and `ALL
#   shards stale` each occur 0 times in the entire 66.43h run, and `Restarting
#   shard N` 0 times. The whole book-feed recovery path never executed once.
#   WHY WE DO NOT RECONNECT ON THIS: the venue itself reconnected shard 1 at
#   04:10:49 and shard 0 at 04:22:38 mid-stall ("no close frame received or sent",
#   which forces reconnect + resubscribe). Throughput in the 10min after each was
#   LOWER than the 5min before (max 13.1 and 15.6 msg/s vs 542.8 median). A
#   reconnect did not fix it, twice. Restarting on the floor would have fired ~310
#   futile resnapshots over 3.9h at ~10% of evals each. So R50 LOGS ONLY.
#   Trading was NOT compromised: book_stale went 79,848 -> 113,677 (+33,829) across
#   04:10:49-07:46:49 and attempts=43 fills=39 was IDENTICAL at both ends - zero
#   trades on stale books. book_not_ready moved only +321, so the books existed and
#   were correctly judged too old. The cost is degraded TAPE, not bad fills, and
#   tape is what P4 gets graded on - which is the whole reason to mark it.
WS_MAX_QUEUE=4096
WS_DUTY_LOG_S=60
# Per-shard msgs/s floor. Below it _health_loop emits ONE WARNING per shard per
# cycle and does nothing else - it does NOT reconnect (see DEFECT 2 above).
# Re-derived from all 7668 WSDUTY samples: 7278 clean 60s windows give p0.1=1.4/s
# p1=36.7/s p50=540.5/s p95=1262.3/s; the 390 stall windows give p50=2.28/s
# p90=9.68/s max=18.5/s. 20/s sits above EVERY stall window and below only 0.71%
# of clean ones (52/7278, ~0.8/h of harmless log noise). 0 disables.
# Operational use: a sustained run of these warnings means the shadow tape for
# those timestamps is degraded - exclude that span from P4, do not restart.
WS_MIN_MSG_RATE=20

# --- RESEARCH GATES, LOOSENED. Each cites its count from the verified ----
# --- 22h skip census (opus.log 09:50:31 STATUS skip_summary).           ---

# side_filter=260090 skips. Shadow UP base rate 50.42% CI[46.77,54.06] - a coin
# flip - so there is no verified UP edge to protect. Symmetric is unbiased.
LATARB_SIDE_FILTER=BOTH

# disp_floor=301657 skips, the largest single rejection.
# rev2 CORRECTION. rev1 claimed 0.0 unlocks these. It does not. nc.py:7913
# enforces |log_disp| >= 0.15 * sigma_horizon with NO env override, and
# verify_ceiling.py (run against nc.py's own _fee_per_share) measured what that
# floor actually costs at the sigma floor:
#   ttc 30s -> 2.05 bps | 45s -> 2.52 | 60s -> 2.90 | 135s -> 4.36 | 285s -> 6.33
# So 0.0 only removes the env floor BELOW ~5 bps, and for ttc >= 150s the
# hardcoded floor is STRICTER than the 5.0 it replaces. Setting 0.0 is still
# correct - the floor under measurement must not also be a filter - but it buys
# far less than the 301,657 headline. Making 0.15 tunable is a code change, not
# an env change, and is deferred out of this run on purpose.
LATARB_MIN_DISP_BPS=0.0

# ask_cap=135082 skips.
# rev2: now justified by a computed number instead of "leaves headroom".
# model_prob is clamped [0.3,0.85] at nc.py:7927, and the gate at nc.py:7951 is
# edge = model_prob - ask - slip - fee >= LATENCY_ARB_EDGE. Solving that with
# nc.py's own fee function gives the highest ask the gate can EVER admit:
#   model_prob 0.85 -> ask 0.8291 at edge=0.010   (0.8186 at edge=0.020)
# 0.80 sits just inside that ceiling, so it is reachable rather than decorative.
# It also means 68.4% of purchasable moments (ask >= 0.90, R48.6) are
# STRUCTURALLY unreachable at any env setting - see sol_ver.md R50.
LATARB_ASK_CAP=0.85
LATARB_MIN_ASK=0.20

# edge_low=5907 skips. Halved, not zeroed: 0.0 disables the gate and the log
# stops recording the decision, which destroys the measurement.
LATENCY_ARB_EDGE=0.010
LATENCY_ARB_MIN_PROB=0.50
LATENCY_ARB_COOLDOWN_S=2.0

# spread_too_wide=34362 skips.
MAX_SPREAD_PCT=0.15
# depth_low=22 skips - not binding; matched to the $5 clip.
MIN_TOP_BOOK_USDC=5.0
# interval_dir_cap=40 skips.
MAX_LATARB_PER_INTERVAL_DIR=2

# Adverse-selection gate: KEPT ON, set to the code's calibrated default.
# rev2 CORRECTION. rev1 flagged .env's tighter 25.0 as a session-silencing risk.
# Verified at nc.py:2399-2406 that R22 already fixed the latch: the EWMA decays
# by half every ADVERSE_EWMA_HALFLIFE_S (300s default), so a +151bps toxic patch
# throttles for ~log2(151/25)*300s = 13 min, not the rest of the session. The
# risk was overstated. 40.0 is nc.py:656's calibrated default (toxic-only p50
# ~250bps, p75 ~89bps), stated explicitly here so the run does not silently
# inherit .env's tighter 25.0 and throttle a measurement it was meant to record.
ADVERSE_SELECT_GATE=true
MAX_ADVERSE_BPS=40.0

# --- DELIBERATELY *NOT* LOOSENED ----------------------------------------
# oracle_stale=54841, the 2nd largest real skip. A stale oracle read is ADVERSE
# SELECTION - trading on information the venue already has - so loosening it
# would manufacture signal rather than measure it.
# rev2 CORRECTION: rev1 said "stays at its 1.2s code default - do not set it
# here", implying a knob exists. It does not. LATARB_ORACLE_MAX_AGE_S is a
# module constant at nc.py:252 with no os.getenv, so it cannot be set from any
# env file. Related, verified: _health_loop only reconnects Chainlink after
# 20.0s stale (nc.py:11007) while the gate rejects at 1.2s, so a feed 1.2-20s
# stale produces oracle_stale skips with no recovery attempt. Env cannot reach
# either number; both are logged as code proposals in sol_ver.md R50.
#
# EMP mode stays OFF (both unset => _emp_q() returns 0.0 => nc.py:7935-7937
# skips the substitution and GBM model_prob drives the gate). Setting
# LATARB_EMP_WR_UP without fresh evidence fabricates a prior, and measuring q is
# the entire point of this run. Both-or-neither enforced at nc.py:809.
# LATARB_EMP_WR_UP=
# LATARB_EMP_WR_DN=
# Band-aware q needs P4 evidence first (nc.py:817-828 both-or-neither).
LATARB_Q_SPLIT_ASK=0.0
#
# REQUIRE_LATARB_LIVE_PROOF is left unset on purpose. Verified inert in dry run:
# nc.py:9946 gates the boot check on `not self.cfg.dry_run`, and nc.py:10917
# forces the sizing flag off when dry_run. .env's `true` neither blocks boot nor
# protects anything here - do not read it as a live safeguard.

# --- R48 SHADOW TAPE: unchanged, byte for byte ---------------------------
# The panel keeps recording independently of the trading gates, and the CSV
# header must not drift or _write_shadow_row rotates the tape.
# NOTE (verified, unchanged on purpose): LATARB_SHADOW_MAX_AGE_MS cannot usefully
# be raised. nc.py:8265 checks it, then nc.py:8267 immediately requires
# fresh_books(LATARB_DUAL_BOOK_STALE_MS) where that constant is HARDCODED 250.0
# at nc.py:160. Any value above 250 is dominated two lines later and admits zero
# extra rows. Keeping 250 so the env states the gate that is actually in force.
# Consequence to carry into the analysis: both the tape and the live path are
# conditioned on BOTH books having been touched within 250ms, i.e. on the most
# actively quoted moments. That is the purchasable set, which is the right
# conditioning for calibration, but it is a conditioning and must be stated.
LATARB_SHADOW=true
LATARB_SHADOW_PATH=/home/ubuntu/latarb_shadow_v20_strict.csv
LATARB_SHADOW_MIN_AGE_MS=0.0
LATARB_SHADOW_THROTTLE_MS=3000.0
LATARB_SHADOW_MAX_AGE_MS=250.0
SHADOW_PROBE_ENABLED=true

# --- CALIBRATION CAPTURE: this run exists to produce this file -----------
CALIBRATION_LOG_ENABLED=true
CALIBRATION_LOG_PATH=/home/ubuntu/calibration.csv
LATENCY_ARB_ENABLED=true

# --- COIN UNIVERSE: 3 -> 6 (rev7 2026-08-28) -----------------------------
# COINS was ABSENT here, so the run used nc.py:771's default 'BTC,ETH,SOL'.
# Every leg of the added coins was probed live from the box on 2026-08-28,
# not assumed (sol_ver.md R50.17):
#   1. Gamma has live 5m AND 15m up/down markets, acceptingOrders=true, for
#      xrp bnb doge (slug pattern {coin}-updown-5m-{epoch}, nc.py:4182).
#   2. Polymarket RTDS topic 'crypto_prices_chainlink' publishes btc eth sol
#      xrp bnb doge hype zec at ~0.87 tick/s each. This is the SETTLEMENT
#      anchor and LatArb whitelists src=='chainlink' (nc.py:5093), so a coin
#      absent from this topic would emit ZERO signals in silence.
#   3. Binance spot {coin}USDT exists for the reference leg (nc.py:3165).
#   4. CLOB top-of-book depth was $10-$423 vs the MIN_TOP_BOOK_USDC=6.0 gate.
#   5. 6-coin discovery = 2.15 req/s to Gamma: 144/144 HTTP 200 over 67s,
#      measured WHILE the live bot was making its own calls.
# EXCLUDED, with the disqualifying measurement:
#   HYPE - no Binance pair. api.binance.com returns {"code":-1121,
#          "msg":"Invalid symbol."} for HYPEUSDT. The reference leg cannot
#          exist, so HYPE is not addable by any env change.
#   ZEC  - chainlink tick and ZECUSDT both fine, but /book returned asks=0
#          bids=0 on BOTH outcomes of zec-updown-5m-1787928900. Nothing to
#          trade. Re-probe before adding.
# WHAT THIS DOES AND DOES NOT BUY: it roughly halves time-to-n for P4. It does
# NOT diversify risk - nc.py:8133 already records BTC DN + SOL DN losing
# together in ONE window and calls N same-direction crypto entries "ONE bet at
# Nx size". 6 correlated coins is a bigger single bet, not 6 independent ones.
# MAX_LATARB_PER_INTERVAL_DIR=2 is what actually bounds that, unchanged.
COINS=BTC,ETH

# Market count doubles (~12 -> ~24: 6 coins x 5m/15m x 2 offsets), and the run
# already logs ~8.6 slow-consumer 1013 closes/h at 2 shards with 1141-1840
# msg/s per shard. Fan-out is a pure crc32 hash (nc.py:3657
# zlib.crc32(tid) % shard_count), so any count >= 1 is valid.
WS_SHARD_COUNT=4

# Eval semaphore (nc.py:4998), sized 5 for ~12 markets. Left at 5 while market
# count doubles, evals queue, and LATARB_SHADOW_MAX_AGE_MS=250 would DROP the
# delayed ones - biasing the P4 tape toward moments the bot happened to be
# idle. Raised with the market count. nc.py:8139 states this is a throughput
# knob and explicitly NOT a risk control, so raising it caps no exposure.
MAX_CONCURRENT_EVALS=10

# 2026-09-03: quiet filter OFF, explicitly. The source default was 3 (ON) and neither
# env layer set this key, so the gate was armed by omission. Two builds spanning
# 4h50m made attempts=0 fills=0: the gate sits after the edge gate, so the skip
# census read edge_low=2915 and not_quiet=117 with zero candidates surviving. The
# quiet cell is closed as look-ahead bias (66 of 66 winners at ttc 30-120s; the bot
# went 2 of 5 for -6.04 USD on the markets it really filled), so OFF is correct and
# this line is the record of that decision.
LATARB_QUIET_MIN_SAMPLES=0
LATARB_ORACLE_MAX_AGE_S=1.2

# r52: LatArb now honors ENTRY_MODE (was hardcoded FAK). Maker fee is 0 on this
# venue; the 2026-09-04 run paid $11.74 fees on an $11.67 gross loss.
ENTRY_MODE=maker
MAKER_GTD_TTL_S=120.0

# r52b: opus.py:2851 fills ANY non-FOK/FAK order (i.e. every GTC maker post) on a
# 70% coin flip, full size, at our own limit price - no queue, no adverse
# selection. For a passive strategy that is the entire cost term, so a maker run
# with 0.7 here reports fabricated profit. The DRYSLIP optimism detector only
# guards the FOK/FAK branch, so nothing would have caught it. 0.0 = post, log,
# book no fill. Restore only once fills are earned from observed book/tape data.
DRY_RUN_FILL_PROB=0.0
